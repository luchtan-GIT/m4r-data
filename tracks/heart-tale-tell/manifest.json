        },
        {
          "time_sec": 124.0,
          "duration_sec": 3.5,
          "text": "this is not a composed rhythm."
        },
        {
          "time_sec": 130.0,
          "duration_sec": 4.0,
          "text": "this is what happens when four people read at different speeds."
        },
        {
